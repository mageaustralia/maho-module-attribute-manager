/**
 * "Bulk Options" tab template.
 *
 * Two sections, three independent admin forms (none of which reuse the native
 * option[...] / default[] / frontend_label[...] field names while submitting
 * through the shared #edit_form — each posts to its own module controller
 * action so nothing collides with the native "Manage Label / Options" tab):
 *
 *   Section 1 — "In batch": a large textarea of newline-separated values,
 *               POSTed to addAction (batch add).
 *   Section 2 — "One by one": a full editable options grid (Admin + per-store
 *               labels, Position, Is Default, Merge, Merge goal, drag handle,
 *               Add Option, Delete) inside its OWN <form>. The Save button
 *               POSTs to saveAction; the "Merge Selected Options" button swaps
 *               the form action to mergeAction (after a confirm) then submits.
 *
 * Native Maho admin CSS classes are reused (entry-edit / entry-edit-head /
 * fieldset / data-table / input-text / scalable) so the tab looks native.
 *
 * Vanilla JS only — no Prototype/jQuery. HTML5 drag-and-drop reorders rows and
 * rewrites the Position inputs. Add/Delete are vanilla DOM operations.
 * Only escapeHtml()/escapeUrl() are used (escapeHtmlAttr does not exist).
 *
 * @var Mageaustralia_AttributeManager_Block_Adminhtml_Tab $this
 */
$attributeId   = $this->getAttributeId();
$formKey       = $this->getFormKey();
$stores        = $this->getStores();
$rows          = $this->getOptionRows();
$defaultType   = $this->getDefaultInputType();
?>
<style>
/* Polish: centre the drag handle vertically in its row, and space the
   stacked Delete buttons so they don't read as one solid red bar. */
#mageaustralia-attributemanager-grid td { vertical-align: middle; }
#mageaustralia-attributemanager-grid td.mam-drag { font-size: 16px; line-height: 1; }
#mageaustralia-attributemanager-grid .mam-delete-row { margin: 3px 0; }
/* Match the native options grid: give each store-view column a fixed width
   so long headers (e.g. "Tennis Warehouse Australia") wrap inside their own
   column instead of bleeding into the next one, and let the label inputs
   fill the column. */
#mageaustralia-attributemanager-grid th { white-space: normal; }
#mageaustralia-attributemanager-grid .mam-store-col { width: 160px; }
#mageaustralia-attributemanager-grid td.mam-store-col input.input-text { width: 100%; box-sizing: border-box; }
/* Drag feedback: the row being dragged goes semi-transparent (like Elgentos),
   so it's obvious the whole option is moving, not just the handle. */
#mageaustralia-attributemanager-grid tr.mam-dragging td { opacity: 0.45; background: #fff7e6; }
/* Keep the batch textarea a sensible size instead of stretching to the full
   (grid-widened) content width, and give both sections bottom breathing room. */
#mageaustralia-attributemanager-add-textarea { max-width: 900px; }
#mageaustralia-attributemanager-bulk .fieldset,
#mageaustralia-attributemanager-grid-wrap .fieldset { padding-bottom: 20px; }
</style>
